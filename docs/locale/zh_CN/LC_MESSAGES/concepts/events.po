#: ../../concepts/events.rst:2
msgid "Three kinds of events"
msgstr "三类事件"

#: ../../concepts/events.rst:4
msgid "Zett Agent uses the word \"event\" for three different things. Choosing the right one is the difference between a UI that updates and one that silently does nothing."
msgstr "Zett Agent 把“事件”这个词用在三种不同的东西上。选对哪一种，决定了你的 UI 是能实时更新，还是悄无声息地什么都不做。"

#: ../../concepts/events.rst:12
msgid "Kind"
msgstr "类型"

#: ../../concepts/events.rst:13
msgid "Sent with"
msgstr "发送方式"

#: ../../concepts/events.rst:14
msgid "Received by"
msgstr "接收方"

#: ../../concepts/events.rst:15
msgid "Typical use"
msgstr "典型用途"

