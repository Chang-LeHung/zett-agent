#: ../../extending/state.rst:2
msgid "State, concurrency, and cleanup"
msgstr "状态、并发与清理"

#: ../../extending/state.rst:5
msgid "State has an owner and a lifetime"
msgstr "状态有归属者，也有生命周期"

#: ../../extending/state.rst:7
msgid "Choose storage by lifetime"
msgstr "按生命周期选择存放位置"

#: ../../extending/state.rst:11
msgid "Lifetime"
msgstr "生命周期"

#: ../../extending/state.rst:12
msgid "Suitable location"
msgstr "合适的位置"

